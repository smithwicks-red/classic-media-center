+    /* tls18 PATCH 1 (insecure option). 0 = full certificate validation
+     * (trust anchors, dates, host name) -- the default, and what a
+     * zero-filled config gives you. Nonzero = accept ANY certificate
+     * chain for this one connection: the chain is still parsed, and the
+     * error validation WOULD have produced is kept for the caller
+     * (OSTLS_GetIgnoredCertError), but it is not enforced. Session
+     * resumption (1.2 cache and 1.3 tickets) is neither offered nor
+     * stored by an insecure connection, so an unverified session can
+     * never be resumed by a verified one. Works on 1.2 and 1.3. */
+    int insecure_skip_verify;
 } OSTLSConfig;
 
